# ChatVibe AI - Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# For Vercel deployment, set these in the Vercel dashboard under Settings > Environment Variables

# ============================================
# Required Core Variables
# ============================================

# Database - PostgreSQL connection string
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/chatvibe?sslmode=require

# Redis - Redis connection string for BullMQ job queue
# Example: redis://user:password@host:6379
# Or: rediss://user:password@host:6380 (for TLS)
REDIS_URL=redis://user:password@host:6379

# Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Authentication & Security
# ============================================

# JWT Secrets - Generate strong random strings (min 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_chars

# Frontend Origin - Your production frontend URL
# Example: https://chatvibe.vercel.app
FRONTEND_ORIGIN=https://your-domain.vercel.app

# Next.js Public Base URL - Used for API calls from frontend
# Example: https://chatvibe.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# ============================================
# Job Queue Configuration
# ============================================

# BullMQ Queue Name (default: analysis-queue)
QUEUE_NAME=analysis-queue

# ============================================
# Stripe Payment Integration (Optional)
# ============================================

# Stripe API Keys - Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs for subscription tiers
# Create these in Stripe Dashboard → Products
# Basic: $2.99/month recurring
STRIPE_PRICE_ID_BASIC=price_your_basic_price_id
# Pro: $5.99/month recurring
STRIPE_PRICE_ID_PRO=price_your_pro_price_id

# Payments Gating (for regions where Stripe live is unavailable)
# Set to "false" to disable live payments (system works in TEST MODE)
# When false: Subscribe buttons show "Coming Soon", API returns 503
PAYMENTS_ENABLED=true

# ============================================
# Email Configuration (Optional)
# ============================================

# SMTP settings for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ============================================
# Monitoring & Logging (Optional)
# ============================================

# Sentry DSN for error tracking
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# Worker-Specific Variables (for separate worker deployment)
# ============================================
# These are used when deploying server/workers/index.js separately
# (e.g., on Railway, Render, or Fly.io)

# Worker concurrency (number of jobs processed simultaneously)
WORKER_CONCURRENCY=5

# Worker max jobs per second
WORKER_MAX_JOBS=10

# ============================================
# Advanced Configuration (Optional)
# ============================================

# Token Expiry Times
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Password Hashing Rounds (default: 12)
BCRYPT_ROUNDS=12

# OpenAI API Key (optional, for embeddings fallback)
OPENAI_API_KEY=sk-your_openai_key_here

# ============================================
# Vercel-Specific Notes
# ============================================
# 
# In Vercel Dashboard:
# 1. Go to Settings > Environment Variables
# 2. Add each variable above for Production environment
# 3. For Vercel, you can also use Vercel Secrets:
#    - Go to Settings > Secrets
#    - Create secrets and reference them in vercel.json
#
# Example vercel.json env mapping:
# {
#   "env": {
#     "DATABASE_URL": "@database_url",
#     "REDIS_URL": "@redis_url",
#     ...
#   }
# }

