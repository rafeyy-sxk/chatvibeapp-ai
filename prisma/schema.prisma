generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  username           String            @unique
  email              String?           @unique
  passwordHash       String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt @default(now())
  failedLoginCount   Int               @default(0)
  isLockedUntil      DateTime?
  resetTokenHash     String?
  resetTokenExpiry   DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?           @db.Text
  refreshTokens      RefreshToken[]
  analysisReports    AnalysisReport[]
  analysisJobs       AnalysisJob[]
  userSessions       UserSession[]
  activityLogs       UserActivityLog[]
}

model RefreshToken {
  id           String       @id @default(cuid())
  user         User         @relation(fields: [userId], references: [id])
  userId       String
  tokenHash    String
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  revoked      Boolean      @default(false)
  replacedById String?
  fingerprint  String?
  userSession  UserSession?
}

model AnalysisReport {
  id            String       @id @default(cuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  jobId         String?      @unique
  job           AnalysisJob? @relation(fields: [jobId], references: [id])
  rawText       String       @db.Text
  analyticsJson Json
  geminiSummary Json
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt], map: "AnalysisReport_userId_createdAt_idx")
  @@index([jobId])
  @@index([createdAt])
  @@index([userId, createdAt(sort: Desc)], map: "AnalysisReport_userId_createdAt_desc_idx")
}

model AnalysisJob {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  status       JobStatus       @default(QUEUED)
  progress     Int             @default(0)
  priority     Int             @default(5)
  inputText    String?         @db.Text
  imageCount   Int?
  customPrompt String?         @db.Text
  errorMessage String?         @db.Text
  retryCount   Int             @default(0)
  maxRetries   Int             @default(3)
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  vibe         String?         @db.Text
  shareToken   String?         @unique
  isPublic     Boolean         @default(false)
  language     String          @default("eng")
  report       AnalysisReport?

  @@index([userId, createdAt])
  @@index([status, priority, createdAt])
  @@index([status, createdAt], map: "AnalysisJob_status_createdAt_idx")
  @@index([userId, status, createdAt])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)], map: "AnalysisJob_status_createdAt_desc_idx")
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  OCR_IN_PROGRESS
  ANALYSIS_IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

model UserSession {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  refreshTokenId    String?       @unique
  refreshToken      RefreshToken? @relation(fields: [refreshTokenId], references: [id])
  deviceFingerprint String
  userAgent         String        @db.Text
  ipAddress         String
  location          String?
  isActive          Boolean       @default(true)
  lastActivityAt    DateTime      @default(now())
  createdAt         DateTime      @default(now())
  expiresAt         DateTime

  @@index([userId, isActive])
  @@index([deviceFingerprint])
  @@index([expiresAt])
}

model UserActivityLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  activityType String
  ipAddress    String
  userAgent    String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([activityType, createdAt])
  @@index([createdAt])
}

model CacheEntry {
  key       String   @id
  value     String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([createdAt])
}
